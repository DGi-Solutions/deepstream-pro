+    const int noConfig = mpv_set_option_string(d_ptr->m_mpv, "config", "no");
+    const int noAutoload = mpv_set_option_string(d_ptr->m_mpv, "load-scripts", "no");
+    const int noScripts = mpv_set_option_string(d_ptr->m_mpv, "scripts", "");
+    const int noIpc = mpv_set_option_string(d_ptr->m_mpv, "input-ipc-server", "");
