find_library(FOUNDATION Foundation)
find_library(APPKIT AppKit)
find_library(IOKIT IOKit)
find_library(COCOA Cocoa)
find_Library(CARBON Carbon)
find_library(SECURITY Security)
find_library(MEDIAPLAYER MediaPlayer)
find_library(COREAUDIO CoreAudio)

set(OS_LIBS ${FOUNDATION} ${APPKIT} ${IOKIT} ${COCOA} ${SECURITY} ${CARBON} ${COREAUDIO} hidremote letsmove)
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -framework MediaPlayer")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS}")
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -mmacosx-version-min=27.2 -fno-omit-frame-pointer")
set(WARNINGS "-Wall")

set(HAVE_UPDATER 1)
find_program(UPDATER_PATH updater HINTS ${CMAKE_FIND_ROOT_PATH}/update_installer/ NO_DEFAULT_PATH)
if(${UPDATER_PATH} MATCHES "UPDATER_PATH-NOTFOUND")
  set(HAVE_UPDATER 0)
  message(STATUS "will build without the updater")
endif(${UPDATER_PATH} MATCHES "UPDATER_PATH-NOTFOUND")

set(INSTALL_BIN_DIR .)
set(INSTALL_RESOURCE_DIR Resources)

if(DEEPSTREAM_EXPERIMENTAL_AV_FIXTURE OR DEEPSTREAM_EXPERIMENTAL_AUDIO_HLS)
  find_library(AVFOUNDATION AVFoundation REQUIRED)
  find_library(QUARTZCORE QuartzCore REQUIRED)
  find_library(COREMEDIA CoreMedia REQUIRED)
  list(APPEND OS_LIBS ${AVFOUNDATION} ${QUARTZCORE} ${COREMEDIA})
endif()

if(DEEPSTREAM_EXPERIMENTAL_AUDIO_HLS)
  find_library(AUDIOTOOLBOX AudioToolbox REQUIRED)
  list(APPEND OS_LIBS ${AUDIOTOOLBOX})
endif()

if(DEEPSTREAM_HLS_CONTROLLED_MPV_TEST)
  find_library(AVKIT AVKit REQUIRED)
  list(APPEND OS_LIBS ${AVKIT})
endif()
